# 运行模式：
#   mock   默认, 零 Key 确定性生成
#   real   v2 工具循环 Agent（模型自主决策，推荐）
#   legacy 旧版写死管道（用于 A/B 对照）
AGENT_MODE=mock

# ===== 仅 AGENT_MODE=real 时需要：工具循环开关 =====
# 最多决策轮数（超过则降级为 mock 计划）
AGENT_MAX_TURNS=6
# 单次规划全局超时（秒）
AGENT_TIMEOUT=40

# ===== 仅 AGENT_MODE=real / legacy 时需要 =====

# LLM（OpenAI 兼容接口，可换 DeepSeek / 通义 / 本地 vLLM 等）
LLM_API_KEY=your_llm_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini

# 高德地图 Key（申请地址 https://lbs.amap.com/ ，均为免费配额）
# 注意两种 key 用途不同，建议分开创建：
#   AMAP_API_KEY     -> 「Web 服务」类型，后端调用 POI/天气/地理编码（服务端，勿泄露）
#   AMAP_WEB_KEY     -> 「Web 端(JS API)」类型，前端加载真实地图
#   AMAP_SECURITY_CODE -> JS API 2.0 安全密钥（在「安全密钥」处获取，推荐配置）
AMAP_API_KEY=your_amap_server_key
AMAP_WEB_KEY=your_amap_web_key
AMAP_SECURITY_CODE=your_amap_security_code
